# ==================================================
# AVEEZ FASHION — ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/aveez_fashion

# Application Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
NEXT_PUBLIC_SITE_URL=https://aveezfashion.com

# Payment Gateway Configuration (Razorpay / Cashfree)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Transactional Email Service (SMTP / Resend)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASSWORD=
EMAIL_FROM=orders@aveezfashion.com

# Customer Support
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_SUPPORT_EMAIL=support@aveezfashion.com
